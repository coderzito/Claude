# --- Database ---
DATABASE_URL=postgres://coldcall:coldcall@localhost:5432/coldcall

# --- Object storage (S3-compatible; MinIO for local dev) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=coldcall-audio
S3_ACCESS_KEY=coldcall
S3_SECRET_KEY=coldcall123
S3_FORCE_PATH_STYLE=true

# --- AI provider ---
# Groq's API is OpenAI-compatible and free-tier (no card required). One key
# powers chapter generation, grading, and transcription (Whisper) — see
# server/src/config.ts and the `services/` modules that use it.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_GENERATION_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
MODEL_VERSION=groq-llama-3.3-70b-v1

# --- Auth ---
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=30d

# --- App config ---
PORT=8080
CLIENT_ORIGIN=http://localhost:5173
FREE_TIER_DAILY_SESSIONS=3
STUDY_MINUTES=15
MIN_STUDY_MINUTES_BEFORE_SPEECH=12
SPEECH_MIN_SECONDS=120
SPEECH_MAX_SECONDS=300
