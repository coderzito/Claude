# --- Database ---
DATABASE_URL=postgres://coldcall:coldcall@localhost:5432/coldcall

# --- Object storage (S3-compatible; MinIO for local dev) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=coldcall-audio
S3_ACCESS_KEY=coldcall
S3_SECRET_KEY=coldcall123
S3_FORCE_PATH_STYLE=true

# --- AI providers ---
# Chapter generation + grading (structured JSON) run on Anthropic's API.
ANTHROPIC_API_KEY=
GENERATION_MODEL=claude-sonnet-5
MODEL_VERSION=claude-sonnet-5-v1

# Transcription. Any provider that returns word/segment-level timestamps works;
# the server calls out to a single `transcribe()` function in server/src/services/transcription.ts.
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# --- Auth ---
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=30d

# --- App config ---
PORT=8080
CLIENT_ORIGIN=http://localhost:5173
FREE_TIER_DAILY_SESSIONS=3
STUDY_MINUTES=15
MIN_STUDY_MINUTES_BEFORE_SPEECH=12
SPEECH_MIN_SECONDS=120
SPEECH_MAX_SECONDS=300
