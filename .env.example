# --- Database ---
DATABASE_URL=postgres://coldcall:coldcall@localhost:5432/coldcall

# --- Object storage (S3-compatible; MinIO for local dev) ---
# In production (Fly.io) these are replaced by the AWS_*/BUCKET_NAME secrets
# that `fly storage create` sets automatically for Tigris — see server/src/config.ts.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=coldcall-audio
S3_ACCESS_KEY=coldcall
S3_SECRET_KEY=coldcall123
S3_FORCE_PATH_STYLE=true

# --- AI provider ---
# Groq's API is OpenAI-compatible and free-tier (no card required). One key
# powers chapter generation, grading, and transcription (Whisper) — see
# server/src/config.ts and the `services/` modules that use it.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_GENERATION_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
MODEL_VERSION=groq-gpt-oss-120b-v1
# Groq's model lineup changes over time — list what's currently live and
# supports tool calling with: curl https://api.groq.com/openai/v1/models \
#   -H "Authorization: Bearer $GROQ_API_KEY" | jq '.data[] | select(.supported_features | index("tools"))'

# --- Auth ---
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=30d

# --- App config ---
PORT=8080
CLIENT_ORIGIN=http://localhost:5173
FREE_TIER_DAILY_SESSIONS=3
STUDY_MINUTES=4
MIN_STUDY_MINUTES_BEFORE_SPEECH=0
SPEECH_MIN_SECONDS=60
SPEECH_MAX_SECONDS=120
